# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=ctrlp
POSTGRES_PASSWORD=ctrlp_dev_password
POSTGRES_DB=ctrlp
DATABASE_URL=postgres://ctrlp:ctrlp_dev_password@localhost:5432/ctrlp

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO (S3-compatible object storage) ────────────────────
MINIO_ROOT_USER=ctrlp_minio
MINIO_ROOT_PASSWORD=ctrlp_dev_password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ctrlp_minio
S3_SECRET_KEY=ctrlp_dev_password
S3_BUCKET_UPLOADS=uploads
S3_BUCKET_PRINT_READY=print-ready
S3_BUCKET_PREVIEWS=previews

# ── Auth (better-auth) ──────────────────────────────────────
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001
# OAuth (fill in when enabling Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apps ────────────────────────────────────────────────────
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ── Payments (Razorpay — Phase 1 checkout) ──────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
